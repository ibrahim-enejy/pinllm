{
  "manifest_version": 3,
  "name": "PinLLM — Pin LLM Responses & Async Artifact Search",
  "short_name": "PinLLM",
  "version": "0.1.0",
  "description": "Free, open-source browser extension to pin full LLM responses inside ChatGPT, Claude, Gemini & DeepSeek with asynchronous artifact extraction and instant hybrid search.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "PinLLM — Search Pinned Responses & Artifacts",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://www.perplexity.ai/*",
        "https://huggingface.co/chat/*",
        "http://localhost:*/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-pin-drawer": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Toggle the PinLLM Search & Artifact Drawer"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pinllm@opensource.org",
      "strict_min_version": "109.0"
    }
  }
}
